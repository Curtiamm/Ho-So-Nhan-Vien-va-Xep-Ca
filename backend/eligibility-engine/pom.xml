<?xml version="1.0" encoding="UTF-8"?>
<!--
  Framework-free eligibility engine (plain Java 21).

  RULE: no Spring, JPA/Jakarta Persistence or Timefold dependencies here, ever.
  The only dependencies are test-scoped JUnit 5 and AssertJ. The app module's
  ArchitectureTest (T012) enforces this at package level as well.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.hsnv</groupId>
        <artifactId>hsnv-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>eligibility-engine</artifactId>
    <packaging>jar</packaging>

    <name>HSNV – Eligibility Engine</name>
    <description>Pure-Java rule engine answering "may employee X work role R at branch B during shift S?"</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!-- Guard: refuse any framework dependency sneaking into the engine. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>engine-no-framework-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework*</exclude>
                                        <exclude>org.springframework.boot</exclude>
                                        <exclude>jakarta.persistence</exclude>
                                        <exclude>org.hibernate*</exclude>
                                        <exclude>ai.timefold*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
